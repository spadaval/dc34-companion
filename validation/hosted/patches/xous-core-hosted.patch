+
+/// Hosted-only, machine-driven console input. The target is configurable, but
+/// defaults to the Bao/DC34 shell's existing scalar keypress endpoint.
+fn stdin_injector() {
+    use std::io::Read;
+
+    let xns = xous_names::XousNames::new().unwrap();
+    let server = std::env::var("XOUS_HOSTED_STDIN_SERVER")
+        .unwrap_or_else(|_| "_Bao console application_".to_owned());
+    let conn = xns.request_connection_blocking(&server).unwrap();
+    let opcode = std::env::var("XOUS_HOSTED_STDIN_OPCODE")
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+        .unwrap_or(0);
+    let startup_delay_ms = std::env::var("XOUS_HOSTED_STDIN_DELAY_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(1_500);
+    let byte_delay_ms = std::env::var("XOUS_HOSTED_STDIN_BYTE_DELAY_MS")
+        .ok()
+        .and_then(|value| value.parse::<u64>().ok())
+        .unwrap_or(5);
+    std::thread::sleep(std::time::Duration::from_millis(startup_delay_ms));
+    for byte in std::io::stdin().lock().bytes() {
+        let Ok(byte) = byte else { break };
+        if byte.is_ascii() {
+            xous::send_message(
+                conn,
+                xous::Message::new_scalar(opcode, byte as usize, 0, 0, 0),
+            )
+            .unwrap();
+            std::thread::sleep(std::time::Duration::from_millis(byte_delay_ms));
+        }
+    }
 }
 
